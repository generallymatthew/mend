# livekit-server --dev's built-in defaults -- fine for local-only testing,
# do not reuse these against any non-dev LiveKit deployment.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Optional overrides, same convention as ../joint-session-app/.env:
# BUFFER_SECONDS=1.5
# CLASSIFIER_CUT_THRESHOLD=0.9
