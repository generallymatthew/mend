# Render deploy variant of ../Caddyfile: same path-prefix scheme (Thimble
# under /intake/, Seam under /manager/), but listens on Render's injected
# $PORT instead of a fixed local port, and only proxies the apps this
# deploy actually runs.
#
# The index ("/") serves index.html -- the real Thimble/Seam landing page
# -- not Spool. Spool is still reachable, just not at root; everything
# that doesn't match an explicit handle below falls through to it.
#
# Repo-root static pages (about.html, story.html, testers.html, the Mend
# Pitch/ demo assets they embed, etc.) are served directly from disk when
# the request matches an existing file -- no per-page handle block needed
# as more of these get added. Short aliases (/about, /testers, /story,
# /manager-story) rewrite to their .html file first.

:{$PORT} {
	handle_path /intake/* {
		reverse_proxy 127.0.0.1:8420
	}

	handle_path /manager/* {
		reverse_proxy 127.0.0.1:8460
	}

	handle_path /manager-test/* {
		reverse_proxy 127.0.0.1:8481
	}

	root * .

	handle /about {
		rewrite * /about.html
		file_server
	}

	handle /testers {
		rewrite * /testers.html
		file_server
	}

	handle /story {
		rewrite * /story.html
		file_server
	}

	handle /manager-story {
		rewrite * /manager-story.html
		file_server
	}

	@staticfile {
		file
	}
	handle @staticfile {
		file_server
	}

	handle {
		reverse_proxy 127.0.0.1:8423
	}
}
